#: includes/notices.php:18
msgid "Your session has expired. Please try again."
msgstr "Twoja sesja wygasła. Spróbuj ponownie."

#: includes/notices.php:19
msgid "Too many attempts. Please wait a few minutes and try again."
msgstr "Zbyt wiele prób. Poczekaj kilka minut i spróbuj ponownie."

#: includes/notices.php:20 includes/turnstile.php:142
msgid "Please complete the security check and try again."
msgstr "Ukończ weryfikację bezpieczeństwa i spróbuj ponownie."

#: includes/notices.php:21 includes/turnstile.php:143
msgid "The security check failed. Please try again."
msgstr "Weryfikacja bezpieczeństwa nie powiodła się. Spróbuj ponownie."

#: includes/notices.php:22 includes/turnstile.php:144
msgid "The security check is temporarily unavailable. Please try again later."
msgstr "Weryfikacja bezpieczeństwa jest chwilowo niedostępna. Spróbuj ponownie później."

#: includes/notices.php:23
msgid "All fields are required."
msgstr "Wszystkie pola są wymagane."

#: includes/notices.php:24
msgid "Invalid email format."
msgstr "Nieprawidłowy format emaila."

#: includes/notices.php:25
msgid "Invalid username."
msgstr "Nieprawidłowa nazwa użytkownika."

#: includes/notices.php:26
msgid "Username or email already taken."
msgstr "Nazwa użytkownika lub email już zajęty."

#: includes/notices.php:27
msgid "Email is already taken."
msgstr "Ten adres email jest już zajęty."

#: includes/notices.php:28
msgid "Passwords do not match."
msgstr "Hasła się nie zgadzają."

#: includes/notices.php:29
msgid "Password does not meet the strength requirements."
msgstr "Hasło nie spełnia wymagań dotyczących siły."

#: includes/notices.php:30
msgid "Your current password is incorrect."
msgstr "Aktualne hasło jest nieprawidłowe."

#: includes/notices.php:31
msgid "Registration failed. Please try again."
msgstr "Rejestracja nie powiodła się. Spróbuj ponownie."

#: includes/notices.php:32
msgid "We have sent a confirmation email to {email}. Click the link in it to activate your account."
msgstr "Wysłaliśmy wiadomość z potwierdzeniem na adres {email}. Kliknij w link w wiadomości, aby aktywować konto."

#: includes/notices.php:33
msgid "We could not send the confirmation email. Please try again later or contact the site administrator."
msgstr "Nie udało się wysłać wiadomości z potwierdzeniem. Spróbuj ponownie później lub skontaktuj się z administratorem witryny."

#: includes/notices.php:34
msgid "Your account has been activated. You can now log in."
msgstr "Twoje konto zostało aktywowane. Możesz się teraz zalogować."

